model StudentBookingSubject {
  id String @id @default(cuid())

  studentBookingId String
  subjectId        String

  subjectSnapshot String?

  /// Snapshot of TrialClassPrice.amount at booking time (server source of truth).
  unitPrice Decimal @db.Decimal(12, 2)
  currency  String  @default("USD")

  createdAt DateTime @default(now())

  studentBooking StudentBooking @relation(fields: [studentBookingId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id])

  @@unique([studentBookingId, subjectId])
  @@index([studentBookingId])
  @@index([subjectId])
}
