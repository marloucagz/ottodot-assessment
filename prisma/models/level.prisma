/// Education level within a learning method (e.g. Primary, Secondary).
model Level {
  id String @id @default(cuid())

  learningMethodId String

  code String
  name String

  description String?

  active Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningMethod  LearningMethod    @relation(fields: [learningMethodId], references: [id])
  grades          Grade[]
  levelSubjects   LevelSubject[]
  studentBookings StudentBooking[]
  prices          TrialClassPrice[]

  @@unique([learningMethodId, code])
  @@index([learningMethodId])
  @@index([active])
}
