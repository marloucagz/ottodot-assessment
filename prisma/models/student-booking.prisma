/// One student within a booking, with level/grade and selections.
model StudentBooking {
  id String @id @default(cuid())

  bookingId String
  studentId String

  levelId String
  gradeId String

  levelSnapshot String?
  gradeSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  level   Level   @relation(fields: [levelId], references: [id])
  grade   Grade   @relation(fields: [gradeId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  subjects     StudentBookingSubject[]
  capabilities StudentCapabilitySelection[]

  @@unique([bookingId, studentId])
  @@index([bookingId])
  @@index([studentId])
  @@index([levelId])
  @@index([gradeId])
}
