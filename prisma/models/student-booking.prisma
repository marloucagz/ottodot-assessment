/// One student within a booking, with level/grade and selections.
model StudentBooking {
  id String @id @default(cuid())

  bookingId String
  studentId String

  learningMethodId String
  levelId          String
  gradeId          String

  learningMethodSnapshot String?
  levelSnapshot          String?
  gradeSnapshot          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningMethod LearningMethod @relation(fields: [learningMethodId], references: [id])
  level          Level          @relation(fields: [levelId], references: [id])
  grade          Grade          @relation(fields: [gradeId], references: [id])
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student        Student        @relation(fields: [studentId], references: [id])

  subjects     StudentBookingSubject[]
  capabilities StudentCapabilitySelection[]

  @@unique([bookingId, studentId])
  @@index([bookingId])
  @@index([studentId])
  @@index([learningMethodId])
  @@index([levelId])
  @@index([gradeId])
}
