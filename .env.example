# Database (Supabase Postgres)
# Runtime / serverless: use the transaction pooler (port 6543) with pgbouncer
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Migrations / local Next.js / interactive transactions: session mode (port 5432)
# In development the app prefers DIRECT_URL over DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Optional dedicated test database (falls back to DIRECT_URL / DATABASE_URL)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth / API (injectable via env in production)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Trial booking server
RESERVATION_TTL_SECONDS=30
CRON_SECRET="replace-with-cron-secret"
PAYMENT_WEBHOOK_SECRET="replace-with-webhook-secret"

# Demo tooling (required only when NODE_ENV=production)
# DEMO_ENABLED=true
# DEMO_SECRET="replace-with-demo-secret"
