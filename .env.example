# Database (Supabase Postgres)
# Runtime / serverless: use the transaction pooler (port 6543) with pgbouncer
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Migrations / introspection: use the direct or session mode connection (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Optional dedicated test database (falls back to DATABASE_URL)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase Auth / API (injectable via env in production)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Trial booking server
RESERVATION_TTL_SECONDS=300
CRON_SECRET="replace-with-cron-secret"
PAYMENT_WEBHOOK_SECRET="replace-with-webhook-secret"
